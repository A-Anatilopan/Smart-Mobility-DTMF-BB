// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ================================
// M-01 - AUTENTICAZIONE E ACCOUNT
// Copre: UC-07, UC-08, UC-19
// User Stories: UT.11a, UT.11b, OP.12a, OP.12b, AP.07a, AP.07b
// INF: INF-05 (password hashata), INF-09 (autenticazione obbligatoria)
// ================================

model Utente {
  id               Int       @id @default(autoincrement())
  email            String    @unique @db.VarChar(255)
  passwordHash     String    @db.VarChar(255)
  nome             String    @db.VarChar(100)
  cognome          String    @db.VarChar(100)
  dataNascita      DateTime  @db.Date
  codiceFiscale    String    @unique @db.VarChar(16)
  numeroPatente    String?   @db.VarChar(50)
  categoriaPatente String?   @db.VarChar(20)
  scadenzaPatente  DateTime? @db.Date
  ruolo            String    @default("Utente") @db.VarChar(50)
  stato            String    @default("ATTIVO") @db.VarChar(20)
  codiceAttivazione String?  @unique @db.VarChar(20)

  // UC-08.3: tracciamento tentativi falliti per blocco temporaneo
  tentativiFalliti Int       @default(0)
  bloccatoFinoA    DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessioni         Sessione[]
  metodiPagamento  MetodoPagamento[]
  prenotazioni     Prenotazione[]
  corse            Corsa[]
  segnalazioniMezzo SegnalazioneMezzo[] @relation("UtenteSegnalanteMezzo")
  segnalazioniPreseInCarico SegnalazioneMezzo[] @relation("OperatorePresaInCaricoSegnalazioneMezzo")
  segnalazioniUrbane SegnalazioneUrbana[] @relation("AmministrazioneSegnalanteUrbana")
  sessioniOperativeMezzo SessioneOperativaMezzo[] @relation("OperatoreSessioneOperativaMezzo")
  corseTerminateDaOperatore Corsa[] @relation("OperatoreTermineCorsa")
  gestioniMezziScarichi GestioneMezzoScarico[] @relation("OperatoreGestioneMezzoScarico")

  @@map("utenti")
}

model Sessione {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(512)
  utenteId  Int
  scadeAt   DateTime
  createdAt DateTime @default(now())

  utente    Utente   @relation(fields: [utenteId], references: [id], onDelete: Cascade)

  @@map("sessioni")
}

// ================================
// M-02 / M-03 / M-05 - CATALOGO MEZZI
// Il mezzo diventa una vera entita persistita, mantenendo esattamente i nomi
// e i tipi gia usati nel progetto per non rompere la UI, i mock storici e la
// documentazione gia consolidata.
// ================================

model Mezzo {
  id               String   @id @db.VarChar(50)
  codice           String   @unique @db.VarChar(50)
  tipo             String   @db.VarChar(20)
  modello          String   @db.VarChar(100)
  stato            String   @db.VarChar(30)
  batteria         Int
  latitudine       Decimal  @db.Decimal(10, 7)
  longitudine      Decimal  @db.Decimal(10, 7)
  posti            Int
  patenteRichiesta String   @db.VarChar(20)
  areaServizioId   String   @db.VarChar(50)
  areaServizioNome String   @db.VarChar(100)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  prenotazioni     Prenotazione[]
  corse            Corsa[]
  segnalazioni     SegnalazioneMezzo[]
  sessioniOperative SessioneOperativaMezzo[]
  gestioniScarico  GestioneMezzoScarico[]

  @@map("mezzi")
}

// ================================
// M-03 - PRENOTAZIONE E CORSA
// Copre la base strutturale per: UC-01, UC-02, UC-03, UC-05, UC-25
// User Stories future: UT.04, UT.05, UT.06, UT.07, UT.08, OP.05
// Nota: il mezzo resta ancora un riferimento logico tramite mezzoId, perche
// la flotta completa non e ancora modellata in Prisma in questa fase.
// ================================

model Prenotazione {
  id                 Int       @id @default(autoincrement())
  codice             String    @unique @db.VarChar(36)
  utenteId           Int
  mezzoId            String    @db.VarChar(50)
  stato              String    @default("ATTIVA") @db.VarChar(30)
  prenotataAt        DateTime  @default(now())
  scadeAt            DateTime
  annullataAt        DateTime?
  convertitaInCorsaAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  utente Utente @relation(fields: [utenteId], references: [id], onDelete: Cascade)
  mezzo  Mezzo  @relation(fields: [mezzoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  corsa  Corsa?

  @@index([utenteId, stato])
  @@index([mezzoId, stato])
  @@map("prenotazioni")
}

model Corsa {
  id                 Int       @id @default(autoincrement())
  codice             String    @unique @db.VarChar(36)
  utenteId           Int
  terminataDaOperatoreId Int?
  mezzoId            String    @db.VarChar(50)
  prenotazioneId     Int?      @unique
  stato              String    @default("ATTIVA") @db.VarChar(30)
  iniziataAt         DateTime  @default(now())
  // Tiene traccia dell'ultimo momento in cui la corsa e ripartita davvero,
  // cosi possiamo sommare solo i minuti di utilizzo effettivo.
  ultimaRipresaAt    DateTime  @default(now())
  pausaIniziataAt    DateTime?
  terminataAt        DateTime?

  // Coordinate minime per tenere traccia di inizio/fine corsa senza aprire
  // ancora il dominio completo di telemetria o storico posizioni.
  latitudineInizio   Decimal?  @db.Decimal(10, 7)
  longitudineInizio  Decimal?  @db.Decimal(10, 7)
  latitudineFine     Decimal?  @db.Decimal(10, 7)
  longitudineFine    Decimal?  @db.Decimal(10, 7)

  // Questi accumulatori tengono il tempo reale totale in millisecondi.
  // In questo modo il costo finale viene calcolato sul tempo effettivo e non
  // sul numero di segmenti aperti/chiusi con arrotondamenti per eccesso.
  durataUtilizzoMs   Int       @default(0)
  durataPausaMs      Int       @default(0)

  // I costi sono memorizzati in centesimi per evitare problemi di arrotondamento
  // nelle fasi iniziali del dominio pagamenti e tariffazione.
  costoSbloccoCent   Int       @default(0)
  costoUtilizzoCent  Int       @default(0)
  costoPausaCent     Int       @default(0)
  costoTotaleCent    Int       @default(0)
  metodoPagamentoCircuito String? @db.VarChar(30)
  metodoPagamentoUltime4 String? @db.VarChar(4)
  metodoPagamentoAlias String? @db.VarChar(80)
  pagamentoStato     String?   @db.VarChar(30)
  pagamentoAutorizzatoAt DateTime?
  pagamentoAddebitatoAt DateTime?
  codiceAddebitoMock String?   @db.VarChar(50)
  modalitaTerminazione String? @db.VarChar(30)
  notaTerminazioneOperatore String? @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  utente       Utente        @relation(fields: [utenteId], references: [id], onDelete: Cascade)
  mezzo        Mezzo         @relation(fields: [mezzoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  prenotazione Prenotazione? @relation(fields: [prenotazioneId], references: [id], onDelete: SetNull)
  terminataDaOperatore Utente? @relation("OperatoreTermineCorsa", fields: [terminataDaOperatoreId], references: [id], onDelete: SetNull)

  @@index([utenteId, stato])
  @@index([terminataDaOperatoreId])
  @@index([mezzoId, stato])
  @@map("corse")
}

// ================================
// M-04 - METODI DI PAGAMENTO
// Copre la base strutturale per: UC-06
// User Stories future: UT.10
// Nota: il progetto non usa gateway reali. Il tokenMock simula il riferimento
// al provider di pagamento senza salvare numero completo carta o CVV.
// ================================

model MetodoPagamento {
  id           Int      @id @default(autoincrement())
  utenteId     Int
  tipo         String   @default("CARTA") @db.VarChar(20)
  circuito     String   @db.VarChar(30)
  intestatario String   @db.VarChar(120)
  ultime4      String   @db.VarChar(4)
  scadenzaMese Int
  scadenzaAnno Int
  alias        String?  @db.VarChar(80)
  tokenMock    String   @unique @db.VarChar(80)
  stato        String   @default("ATTIVO") @db.VarChar(20)
  predefinito  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  utente Utente @relation(fields: [utenteId], references: [id], onDelete: Cascade)

  @@index([utenteId, stato])
  @@index([utenteId, predefinito])
  @@map("metodi_pagamento")
}

// ================================
// M-05 - SEGNALAZIONI OPERATIVE
// Copre la base condivisa per: UC-09, UC-11
// User Stories future: UT.09, OP.03, OP.04, OP.11
// Nota: il mezzo continua a essere referenziato in modo logico tramite mezzoId
// e mezzoCodice, cosi possiamo aprire il dominio segnalazioni senza modellare
// ancora l'intera flotta in Prisma.
// ================================

model SegnalazioneMezzo {
  id               Int      @id @default(autoincrement())
  codice           String   @unique @db.VarChar(50)
  origine          String   @default("UTENTE") @db.VarChar(20)
  utenteId         Int
  operatorePresaInCaricoId Int?
  mezzoId          String   @db.VarChar(50)
  mezzoCodice      String   @db.VarChar(50)
  categoria        String   @db.VarChar(30)
  descrizione      String   @db.Text
  stato            String   @default("APERTA") @db.VarChar(50)
  presaInCaricoAt  DateTime?
  risoltaAt        DateTime?
  riepilogoRisoluzione String? @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  utente Utente @relation("UtenteSegnalanteMezzo", fields: [utenteId], references: [id], onDelete: Cascade)
  mezzo  Mezzo  @relation(fields: [mezzoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  operatorePresaInCarico Utente? @relation("OperatorePresaInCaricoSegnalazioneMezzo", fields: [operatorePresaInCaricoId], references: [id], onDelete: SetNull)

  @@index([utenteId])
  @@index([operatorePresaInCaricoId])
  @@index([mezzoId])
  @@index([stato])
  @@index([mezzoId, stato])
  @@map("segnalazioni_mezzo")
}

// ================================
// M-05 - OPERAZIONI OPERATORE SUI MEZZI
// Copre la base strutturale per: OP.10
// Nota: la sessione operativa tiene memoria dello stato business originario
// del mezzo, cosi il blocco finale puo ripristinarlo senza perdere il contesto
// operativo precedente.
// ================================

model SessioneOperativaMezzo {
  id                Int      @id @default(autoincrement())
  codice            String   @unique @db.VarChar(50)
  operatoreId       Int
  mezzoId           String   @db.VarChar(50)
  mezzoCodice       String   @db.VarChar(50)
  statoMezzoOrigine String   @db.VarChar(30)
  modalita          String   @default("LOCALE") @db.VarChar(30)
  stato             String   @default("ATTIVA") @db.VarChar(20)
  motivo            String   @db.VarChar(50)
  noteApertura      String?  @db.Text
  noteChiusura      String?  @db.Text
  apertaAt          DateTime @default(now())
  chiusaAt          DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  operatore Utente @relation("OperatoreSessioneOperativaMezzo", fields: [operatoreId], references: [id], onDelete: Cascade)
  mezzo     Mezzo  @relation(fields: [mezzoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([operatoreId])
  @@index([mezzoId])
  @@index([stato])
  @@index([mezzoId, stato])
  @@map("sessioni_operative_mezzo")
}

// ================================
// M-05 - GESTIONE MEZZI SCARICHI
// Copre la base persistente per: OP.09
// Il mezzo resta NON_DISPONIBILE per tutta la filiera logistica, mentre questo
// workflow registra in modo esplicito il ciclo di ritiro, ricarica e rimessa.
// ================================

model GestioneMezzoScarico {
  id                     Int      @id @default(autoincrement())
  codice                 String   @unique @db.VarChar(50)
  operatoreId            Int
  mezzoId                String   @db.VarChar(50)
  stato                  String   @default("RITIRO_PROGRAMMATO_MEZZO_SCARICO") @db.VarChar(50)
  batteriaRilevata       Int
  noteOperative          String?  @db.Text
  ritiroProgrammatoAt    DateTime @default(now())
  mezzoRitiratoAt        DateTime?
  caricaIniziataAt       DateTime?
  caricaCompletataAt     DateTime?
  rimessaProgrammataAt   DateTime?
  rimessaCompletataAt    DateTime?
  chiusaAt               DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  operatore Utente @relation("OperatoreGestioneMezzoScarico", fields: [operatoreId], references: [id], onDelete: Cascade)
  mezzo     Mezzo  @relation(fields: [mezzoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([operatoreId])
  @@index([mezzoId])
  @@index([stato])
  @@index([chiusaAt])
  @@index([mezzoId, chiusaAt])
  @@map("gestioni_mezzi_scarichi")
}

// ================================
// M-06 - SEGNALAZIONI URBANE
// Copre la base persistente per: UC-10
// User Stories future: AP.03
// La PA puo aprire criticita territoriali con titolo, descrizione e
// posizione opzionale, lasciando alla UI futura la scelta tra elenco e mappa.
// ================================

model SegnalazioneUrbana {
  id               Int      @id @default(autoincrement())
  codice           String   @unique @db.VarChar(50)
  amministrazioneId Int
  categoria        String   @db.VarChar(30)
  titolo           String   @db.VarChar(120)
  descrizione      String   @db.Text
  indirizzo        String?  @db.VarChar(160)
  latitudine       Decimal? @db.Decimal(10, 7)
  longitudine      Decimal? @db.Decimal(10, 7)
  stato            String   @default("APERTA") @db.VarChar(30)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  amministrazione Utente @relation("AmministrazioneSegnalanteUrbana", fields: [amministrazioneId], references: [id], onDelete: Cascade)

  @@index([amministrazioneId, stato])
  @@index([stato, createdAt])
  @@index([categoria, stato])
  @@map("segnalazioni_urbane")
}
