// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ================================
// M-01 - AUTENTICAZIONE E ACCOUNT
// Copre: UC-07, UC-08, UC-19
// User Stories: UT.11a, UT.11b, OP.12a, OP.12b, AP.07a, AP.07b
// INF: INF-05 (password hashata), INF-09 (autenticazione obbligatoria)
// ================================

model Utente {
  id               Int       @id @default(autoincrement())
  email            String    @unique @db.VarChar(255)
  passwordHash     String    @db.VarChar(255)
  nome             String    @db.VarChar(100)
  cognome          String    @db.VarChar(100)
  dataNascita      DateTime  @db.Date
  codiceFiscale    String    @unique @db.VarChar(16)
  numeroPatente    String?   @db.VarChar(50)
  categoriaPatente String?   @db.VarChar(20)
  ruolo            String    @default("Utente") @db.VarChar(50)
  stato            String    @default("ATTIVO") @db.VarChar(20)
  codiceAttivazione String?  @unique @db.VarChar(20)

  // UC-08.3: tracciamento tentativi falliti per blocco temporaneo
  tentativiFalliti Int       @default(0)
  bloccatoFinoA    DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessioni         Sessione[]
  prenotazioni     Prenotazione[]
  corse            Corsa[]
  segnalazioniMezzo SegnalazioneMezzo[]

  @@map("utenti")
}

model Sessione {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(512)
  utenteId  Int
  scadeAt   DateTime
  createdAt DateTime @default(now())

  utente    Utente   @relation(fields: [utenteId], references: [id], onDelete: Cascade)

  @@map("sessioni")
}

// ================================
// M-03 - PRENOTAZIONE E CORSA
// Copre la base strutturale per: UC-01, UC-02, UC-03, UC-05, UC-25
// User Stories future: UT.04, UT.05, UT.06, UT.07, UT.08, OP.05
// Nota: il mezzo resta ancora un riferimento logico tramite mezzoId, perche
// la flotta completa non e ancora modellata in Prisma in questa fase.
// ================================

model Prenotazione {
  id                 Int       @id @default(autoincrement())
  codice             String    @unique @db.VarChar(36)
  utenteId           Int
  mezzoId            String    @db.VarChar(50)
  stato              String    @default("ATTIVA") @db.VarChar(30)
  prenotataAt        DateTime  @default(now())
  scadeAt            DateTime
  annullataAt        DateTime?
  convertitaInCorsaAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  utente Utente @relation(fields: [utenteId], references: [id], onDelete: Cascade)
  corsa  Corsa?

  @@index([utenteId, stato])
  @@index([mezzoId, stato])
  @@map("prenotazioni")
}

model Corsa {
  id                 Int       @id @default(autoincrement())
  codice             String    @unique @db.VarChar(36)
  utenteId           Int
  mezzoId            String    @db.VarChar(50)
  prenotazioneId     Int?      @unique
  stato              String    @default("ATTIVA") @db.VarChar(30)
  iniziataAt         DateTime  @default(now())
  // Tiene traccia dell'ultimo momento in cui la corsa e ripartita davvero,
  // cosi possiamo sommare solo i minuti di utilizzo effettivo.
  ultimaRipresaAt    DateTime  @default(now())
  pausaIniziataAt    DateTime?
  terminataAt        DateTime?

  // Coordinate minime per tenere traccia di inizio/fine corsa senza aprire
  // ancora il dominio completo di telemetria o storico posizioni.
  latitudineInizio   Decimal?  @db.Decimal(10, 7)
  longitudineInizio  Decimal?  @db.Decimal(10, 7)
  latitudineFine     Decimal?  @db.Decimal(10, 7)
  longitudineFine    Decimal?  @db.Decimal(10, 7)

  // Questi accumulatori tengono il tempo reale totale in millisecondi.
  // In questo modo il costo finale viene calcolato sul tempo effettivo e non
  // sul numero di segmenti aperti/chiusi con arrotondamenti per eccesso.
  durataUtilizzoMs   Int       @default(0)
  durataPausaMs      Int       @default(0)

  // I costi sono memorizzati in centesimi per evitare problemi di arrotondamento
  // nelle fasi iniziali del dominio pagamenti e tariffazione.
  costoSbloccoCent   Int       @default(0)
  costoUtilizzoCent  Int       @default(0)
  costoPausaCent     Int       @default(0)
  costoTotaleCent    Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  utente       Utente        @relation(fields: [utenteId], references: [id], onDelete: Cascade)
  prenotazione Prenotazione? @relation(fields: [prenotazioneId], references: [id], onDelete: SetNull)

  @@index([utenteId, stato])
  @@index([mezzoId, stato])
  @@map("corse")
}

// ================================
// M-05 - SEGNALAZIONI OPERATIVE
// Copre la base condivisa per: UC-09, UC-11
// User Stories future: UT.09, OP.03, OP.04, OP.11
// Nota: il mezzo continua a essere referenziato in modo logico tramite mezzoId
// e mezzoCodice, cosi possiamo aprire il dominio segnalazioni senza modellare
// ancora l'intera flotta in Prisma.
// ================================

model SegnalazioneMezzo {
  id               Int      @id @default(autoincrement())
  codice           String   @unique @db.VarChar(50)
  origine          String   @default("UTENTE") @db.VarChar(20)
  utenteId         Int
  mezzoId          String   @db.VarChar(50)
  mezzoCodice      String   @db.VarChar(50)
  categoria        String   @db.VarChar(30)
  descrizione      String   @db.Text
  stato            String   @default("APERTA") @db.VarChar(30)
  presaInCaricoAt  DateTime?
  risoltaAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  utente Utente @relation(fields: [utenteId], references: [id], onDelete: Cascade)

  @@index([utenteId])
  @@index([mezzoId])
  @@index([stato])
  @@index([mezzoId, stato])
  @@map("segnalazioni_mezzo")
}
